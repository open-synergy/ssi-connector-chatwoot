<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inbox form view -->
    <record id="view_chatwoot_inbox_form" model="ir.ui.view">
        <field name="name">chatwoot.inbox.form</field>
        <field name="model">chatwoot.inbox</field>
        <field name="arch" type="xml">
            <form string="Chatwoot Inbox" create="false">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" readonly="1" /></h1>
                    </div>
                    <group>
                        <group string="Chatwoot">
                            <field name="backend_id" readonly="1" />
                            <field name="chatwoot_id" readonly="1" />
                            <field name="channel_type" />
                            <field name="sync_date" readonly="1" />
                        </group>
                        <group string="General">
                            <field name="allow_outgoing" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inbox list/tree view -->
    <record id="view_chatwoot_inbox_tree" model="ir.ui.view">
        <field name="name">chatwoot.inbox.tree</field>
        <field name="model">chatwoot.inbox</field>
        <field name="arch" type="xml">
            <tree string="Chatwoot Inboxes" create="false">
                <field name="name" />
                <field name="backend_id" />
                <field name="channel_type" />
                <field name="allow_outgoing" />
                <field name="sync_date" />
            </tree>
        </field>
    </record>

    <!-- Inbox action -->
    <record id="action_chatwoot_inbox" model="ir.actions.act_window">
        <field name="name">Chatwoot Inboxes</field>
        <field name="res_model">chatwoot.inbox</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_chatwoot_inbox"
        name="Inboxes"
        parent="menu_chatwoot_configuration"
        action="action_chatwoot_inbox"
        groups="connector.group_connector_manager"
        sequence="20"
    />
</odoo>
