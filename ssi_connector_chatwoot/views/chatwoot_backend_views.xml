<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Backend form view -->
    <record id="view_chatwoot_backend_form" model="ir.ui.view">
        <field name="name">chatwoot.backend.form</field>
        <field name="model">chatwoot.backend</field>
        <field name="arch" type="xml">
            <form string="Chatwoot Backend">
                <header>
                    <button
                        name="action_test_connection"
                        string="Test Connection"
                        type="object"
                        class="oe_highlight"
                    />
                </header>
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <label for="name" />
                        <h1><field name="name" placeholder="Backend Name" /></h1>
                    </div>
                    <group>
                        <group string="Connection">
                            <field name="url" />
                            <field name="account_id" />
                            <field name="api_token" password="True" />
                        </group>
                        <group string="General">
                            <field name="company_id" />
                            <field name="active" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Backend list/tree view -->
    <record id="view_chatwoot_backend_tree" model="ir.ui.view">
        <field name="name">chatwoot.backend.tree</field>
        <field name="model">chatwoot.backend</field>
        <field name="arch" type="xml">
            <tree string="Chatwoot Backends">
                <field name="name" />
                <field name="url" />
                <field name="account_id" />
                <field name="company_id" />
                <field name="active" />
            </tree>
        </field>
    </record>

    <!-- Backend action -->
    <record id="action_chatwoot_backend" model="ir.actions.act_window">
        <field name="name">Chatwoot Backends</field>
        <field name="res_model">chatwoot.backend</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
